# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ห้ามใส่ NEXT_PUBLIC_ นำหน้า และห้ามให้โค้ดฝั่ง browser เห็น
SUPABASE_SERVICE_ROLE_KEY=

# ตั้งค่าให้ /api/worker/recover เรียกได้เฉพาะจาก Vercel Cron (Vercel ใส่ header นี้ให้อัตโนมัติ
# เมื่อเรียกจาก crons ที่ประกาศใน vercel.json — เราเช็คซ้ำเองเผื่อ misconfiguration)
CRON_SECRET=
